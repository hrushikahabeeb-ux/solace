# --- Database --------------------------------------------------------------------
# MongoDB is the only datastore (users, messages, media blobs, realtime fan-out, call
# state). It must run as a replica set; a single node is fine. `npm run db:setup`
# initialises one for you. For MongoDB Atlas, paste its mongodb+srv:// string instead
# (add the database name, e.g. .../solace?retryWrites=true&w=majority).
MONGODB_URL="mongodb://localhost:27017/solace"

JWT_ACCESS_SECRET="generate with: openssl rand -base64 48"
JWT_REFRESH_SECRET="generate a DIFFERENT one the same way"
WEB_ORIGIN="http://localhost:3000"
PORT=4000
GIPHY_API_KEY=""

# --- Media URLs (optional) ---------------------------------------------------------
# Encrypted uploads/downloads go through signed, expiring URLs on this API. The base URL
# is taken from each request (including X-Forwarded-Proto/Host behind a reverse proxy);
# set PUBLIC_API_URL only if clients reach the API at an address the request doesn't show.
# MEDIA_URL_SECRET defaults to a key derived from JWT_ACCESS_SECRET.
PUBLIC_API_URL=""
MEDIA_URL_SECRET=""

# --- Voice/video calls (optional) -------------------------------------------------
# Calls work on a local network / with permissive NATs using STUN alone. Across strict
# NATs and mobile networks a TURN relay is required. Leave TURN_* empty to run STUN-only.
# STUN_URLS defaults to a public Google STUN server ONLY when TURN_URLS is also empty.
STUN_URLS=""
TURN_URLS=""
TURN_SECRET=""
